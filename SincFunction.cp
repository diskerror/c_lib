/*  Classes for FIR coefficientsby Reid Woodbury 2000-2002*/#include    "SincFunction.h"#include    <fp.h>#include    <assert.h>using namespace std;const double    twoPi   = 2.0D * pi;///////////////////////////////////////////////////////////////////////////////////////////  copy constructorSincFunction ::SincFunction (SincFunction& s) :    H(NULL),    Mo2(s.Mo2),    Mo2real(s.Mo2real),    oversample(s.oversample){    CopyH ( s );}///////////////////////////////////////////////////////////////////////////////////////////  initializevoid SincFunction ::SetSinc (    double          Fc,    double          transition,    unsigned long   overSampIn ){    oversample = overSampIn;            Mo2     = (unsigned long) ((2.0/transition) + 0.5); //  +0.5 for rounding    Mo2real = Mo2 * oversample;    //M = Mo2 * 2UL;            //  M == size of kernal, forces M to be even        NewH();        double natFc = (twoPi * Fc) / (double) oversample;        //  fix the zero divide-by-zero error at H[M/2], or i=0    H[0] = (double_t) natFc;    //  sinc gfunction, set up coefficients for low pass    for ( register unsigned long i = 1;  i <= Mo2real;  i++ )        H[i] = (double_t) (sin(natFc*i))/(double)i;        //  "i" points past last item so set it to zero    H[Mo2real+1UL] = 0.0D;  //  is this needed?        //  normalize sum of all points H to one and offset the gain by the oversample amount    NormalGain( (double) oversample );}/////////////////////////////////////////////////////////////////////////////////////////double_t SincFunction ::GetCoeff ( long i ){    i = mAbs(i);    return (i<=Mo2real) ? H[i] : (double_t)0.0;}/////////////////////////////////////////////////////////////////////////////////////////inline double_t SincFunction ::GetCoeff ( double atIndex ){    atIndex = mAbs(atIndex);        if ( atIndex > Mo2 + 1 )    //  range check        return (double_t) 0.0;        atIndex *= oversample;        unsigned long   atIndexInt = (unsigned long) atIndex;    double          atIndexMod = atIndex - atIndexInt;                                //  subtracting whole number part is same as mod 1        //  return linear interpolation    return ( ( H[atIndexInt] * (1.0D-atIndexMod) ) + ( H[atIndexInt+1] * atIndexMod ) );}///////////////////////////////////////////////////////////////////////////////////////////  normalize to 1x the change gainvoid SincFunction ::NormalGain ( double gain ){    register long   i;    register double sum = 0.0D;        sum = H[0];    for ( i=1; i <= Mo2real; i++ )        sum += ( H[i] * 2.0 );        //  x2 'cause we only have half of the kernal, except for H[0]        Gain ( gain / sum );}/////////////////////////////////////////////////////////////////////////////////////////void SincFunction ::Gain ( double& a ){    if ( a != 1.00D )   //  if not unity gain    {        register long   i;                for ( i=0; i <= Mo2real; i++ )            H[i] *= a;    }}/////////////////////////////////////////////////////////////////////////////////////////SincFunction& SincFunction ::Convolv (SincFunction& s){    unsigned long i, j;        if ( oversample != s.oversample )        throw ( "SincFunction (conv): Oversample amounts are not the same." );        //  ns = new Sinc    SincFunction *ns = new SincFunction( Mo2+s.Mo2, oversample, useAltiVec);        for ( i=0; i <= Mo2real; i++ )        ;        return *ns;}*//////////////////////////////////////////////////////////////////////////////////////////static void SincFunction ::ApplyBlackman ( array &w ){    register double M = w.size()-1;    register double Mo2 = M/2.0D;    for (register long i = 0; i < w.size(); i++ )        w[i] *= ( 0.42D - (0.5D * cos(twoPi*(i+Mo2)/M)) + (0.08D * cos(2.0*twoPi*(i+Mo2)/M)) );}/////////////////////////////////////////////////////////////////////////////////////////static void SincFunction ::ApplyHamming ( array &w ){    register double M = w.size();    register double Mo2 = M/2.0D;    for (register long i = 0; i <= Mo2; i++ )        w[i] *= ( 0.54D - (0.46D * cos(twoPi*(i+Mo2)/M)) );}///////////////////////////////////////////////////////////////////////////////////////////  overloaded operators/////////////////////////////////////////////////////////////////////////////////////////void SincFunction ::operator=(SincFunction& s){    if (H != s.H)           //avoid s = s case    {        Mo2         = s.Mo2;        Mo2real     = s.Mo2real;        oversample  = s.oversample;                CopyH ( s );    }}/////////////////////////////////////////////////////////////////////////////////////////SincFunction& SincFunction ::operator+ (SincFunction& s){    unsigned long i;        if ( oversample != s.oversample )        throw ( "SincFunction (+): Oversample amounts are not the same." );        //  ns == new Sinc    SincFunction *ns = new SincFunction(fmax(Mo2, s.Mo2), oversample);        double maxM     = fmax(Mo2real, s.Mo2real);    double minM     = fmin(Mo2real, s.Mo2real);    for ( i=0; i <= minM; i++ )        ns->H[i] = H[i] + s.H[i];        if ( Mo2real > s.Mo2real )        for ( i=minM + 1; i <= maxM; i++ )            ns->H[i] = H[i];    else        for ( i=minM + 1; i <= maxM; i++ )            ns->H[i] = s.H[i];        return *ns;}/////////////////////////////////////////////////////////////////////////////////////////SincFunction& SincFunction ::operator- (SincFunction& s){    unsigned long i;        if ( oversample != s.oversample )        throw ( "SincFunction (-): Oversample amounts are not the same." );        //  ns == new Sinc    SincFunction *ns = new SincFunction(fmax(Mo2, s.Mo2), oversample);        double maxM     = fmax(Mo2real, s.Mo2real);    double minM     = fmin(Mo2real, s.Mo2real);    for ( i=0; i <= minM; i++ )        ns->H[i] = H[i] - s.H[i];        if ( Mo2real > s.Mo2real )        for ( i=minM + 1; i <= maxM; i++ )            ns->H[i] = H[i];    else        for ( i=minM + 1; i <= maxM; i++ )            ns->H[i] = -s.H[i];        return *ns;}/////////////////////////////////////////////////////////////////////////////////////////SincFunction&operator- ( void ){    unsigned long i;        SincFunction *ns = new SincFunction(*this); //  ns == new Sinc        for ( i=0; i <= Mo2real; i++ )        ns->H[i] *= -1.0;        return *ns;}///////////////////////////////////////////////////////////////////////////////////////////  extra house keeping functions///////////////////////////////////////////////////////////////////////////////////////////  constructor for creating a modified kernalSincFunction ::SincFunction (unsigned long coefs, unsigned long over) :    H(NULL),    Mo2(coefs),    Mo2real(coefs*over),    oversample(over){}///////////////////////////////////////////////////////////////////////////////////////////  copy H from another SincFunction, can recast float to double or double to floatvoid SincFunction ::CopyH (SincFunction& s){    if ( Mo2real != s.Mo2real )        throw ( "SincFunction (copy H): Mo2real != s.Mo2real" );        NewH();        for ( i=0; i <= Mo2real; i++ )        H[i] = s.H[i];}/////////////////////////////////////////////////////////////////////////////////////////void SincFunction ::NewH (void){    if ( H )        //  if it existed, delete the old        delete H;        //  get memory for coefficients, normal M+1, and one more in case we refer past end    //      we want a zero value in the last position    H = new double_t [ Mo2real + 2UL ] ((double_t)0.0);        if ( !H )        throw ("SincFunction (new): Error creating H");}